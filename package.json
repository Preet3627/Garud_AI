{
  "name": "garud-ai-robot",
  "private": true,
  "description": "Desktop control panel for Garud AI Robot with Pipecat and Ollama integration.",
  "author": "Garud AI Team <preetjgfilj2@gmail.com>",
  "version": "0.1.2",
  "repository": {
    "type": "git",
    "url": "https://github.com/Preet3627/Garud_AI.git"
  },
  "type": "module",
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "clean": "rm -rf dist release",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "npm run clean && vite build && electron-builder"
  },
  "dependencies": {
    "@ai-sdk/openai": "^1.1.13",
    "ai": "^4.1.45",
    "bonjour-service": "^1.3.0",
    "dompurify": "^3.4.5",
    "framer-motion": "^12.4.7",
    "lucide-react": "^0.477.0",
    "marked": "^18.0.4",
    "piper-tts-web": "^1.1.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "ssh2": "^1.16.0",
    "vite-plugin-static-copy": "^4.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.15",
    "@types/react-dom": "^19.2.3",
    "concurrently": "^9.1.2",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.garud.ai.robot",
    "productName": "Garud AI Robot",
    "directories": {
      "output": "release"
    },
    "publish": {
      "provider": "github",
      "releaseType": "draft"
    },
    "releaseInfo": {
      "releaseNotesFile": "release-notes/v0.1.2.md"
    },
    "asarUnpack": [
      "pipecat_bridge.py"
    ],
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "pipecat_bridge.py",
      "package.json",
      "node_modules/**/*"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "identity": null,
      "gatekeeperAssess": false,
      "hardenedRuntime": false,
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "win": {
      "artifactName": "${productName}-${version}-win-${arch}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "assets/icon.png"
    },
    "linux": {
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    }
  }
}
