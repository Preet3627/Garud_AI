{
  "name": "garud-ai-robot",
  "private": true,
  "description": "Desktop control panel for Garud AI Robot with Pipecat and Ollama integration.",
  "author": "Garud AI Team <preetjgfilj2@gmail.com>",
  "version": "0.1.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/Preet3627/Garud_AI.git"
  },
  "type": "module",
  "main": "electron-main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "electron:build": "vite build && electron-builder"
  },
  "dependencies": {
    "ai": "^4.1.45",
    "@ai-sdk/openai": "^1.1.13",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "concurrently": "^9.1.2",
    "electron": "^34.2.0",
    "electron-builder": "^25.1.8",
    "typescript": "~5.8.2",
    "vite": "^6.2.0",
    "wait-on": "^8.0.2"
  },
  "build": {
    "appId": "com.garud.ai.robot",
    "productName": "Garud AI Robot",
    "directories": {
      "output": "release"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "Preet3627",
        "repo": "Garud_AI",
        "releaseType": "draft"
      }
    ],
    "files": [
      "dist/**/*",
      "electron-main.cjs",
      "package.json"
    ],
    "mac": {
      "category": "public.app-category.developer-tools",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "win": {
      "target": [
        "nsis",
        "zip"
      ]
    },
    "linux": {
      "target": [
        "AppImage",
        "deb",
        "zip"
      ]
    }
  }
}